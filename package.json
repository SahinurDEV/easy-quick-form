  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "pnpm --stream -r run dev",
    "build": "pnpm --stream -r run build",
    "preview": "pnpm --stream -r run preview"
  },
  "keywords": [
    "mern",
    "form-builder",
    "react",
    "express",
    "typescript",
    "mongodb",
    "drag-and-drop"
  ],
  "author": "Sahinur Islam",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/SahinurDEV/easy-quick-form.git"
  },
  "bugs": {
    "url": "https://github.com/SahinurDEV/easy-quick-form/issues"
  },
  "homepage": "https://github.com/SahinurDEV/easy-quick-form#readme",
  "devDependencies": {
    "prettier": "^3.0.3"
  },
  "pnpm": {
