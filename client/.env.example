# Base URL of the backend API
VITE_BACKEND_BASE_URL=http://localhost:8000/api/v1

# Secret key used to encrypt client-side stored auth state (any long random string)
VITE_SECRET_KEY=

# Google OAuth client ID (same as the server's GOOGLE_CLIENT_ID). Required: sign-in is Google-only.
# Never put the client secret in a VITE_ variable; it would ship in the public bundle.
VITE_GOOGLE_CLIENT_ID=
